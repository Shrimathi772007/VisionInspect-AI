# Copy to .env.docker (Git-ignored) and replace every placeholder:
#   cp .env.docker.example .env.docker
# Used with: docker compose --env-file .env.docker ...

# PostgreSQL (the db container creates this database and user on first start)
POSTGRES_DB=visioninspect_db
POSTGRES_USER=visioninspect
POSTGRES_PASSWORD=change_me_db_password

# JWT. Generate a secret with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_jwt_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origin(s) of the web UI, comma-separated (e.g. http://203.0.113.10:8080 or https://inspect.example.com)
FRONTEND_ORIGINS=http://localhost:8080

# Host folders mounted into the backend (relative paths are relative to this repository root)
AI_MODELS_DIR=./backend/ai_models
DATASET_DIR=./dataset
# Uploads and heatmaps: leave as "storage" for a Docker named volume, or give a host path owned by uid 10001
STORAGE_DIR=storage

# Host port of the web UI. Use 127.0.0.1:8080 when a reverse proxy (e.g. Caddy) on the same host handles HTTPS.
WEB_PORT=8080

# Backend processes and per-category models kept in memory per process (1-15)
UVICORN_WORKERS=1
VISIONINSPECT_AI_MODEL_CACHE_SIZE=3
